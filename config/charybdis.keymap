#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        WORKMAN {
            label = "Base";
            bindings = <
&kp ESCAPE      &kp Q           &kp D           &kp R             &kp W               &kp B        &kp J        &kp F                &kp U              &kp P            &kp SEMICOLON    &lt 8 BACKSLASH
&lt 2 CAPSLOCK  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT H  &mt LEFT_CONTROL T  &kp G        &kp Y        &mt RIGHT_CONTROL N  &mt RIGHT_SHIFT E  &mt RIGHT_ALT O  &mt RIGHT_GUI I  &kp APOSTROPHE
&tog 5          &lt 2 Z         &lt 2 X         &lt 3 M           &lt 4 C             &lt 6 V      &lt 6 K      &lt 4 L              &lt 3 COMMA        &lt 2 DOT        &lt 2 SLASH      &kp DELETE
                                                &lt 3 LEFT_GUI    &lt 2 SPACE         &lt 5 TAB    &lt 3 ENTER  &lt 2 BACKSPACE
            >;
        };

        QWERTY {
            label = "Base2";
            bindings = <
&kp ESCAPE      &kp Q           &kp W           &kp E             &kp R               &kp T        &kp Y        &kp U                &kp I              &kp O            &kp P                    &lt 8 BACKSLASH
&lt 2 CAPSLOCK  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_CONTROL F  &kp G        &kp H        &mt RIGHT_CONTROL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMICOLON  &kp APOSTROPHE
&tog 5          &lt 2 Z         &lt 2 X         &lt 3 C           &lt 4 V             &lt 6 B      &lt 6 N      &lt 4 M              &lt 3 COMMA        &lt 2 DOT        &lt 2 SLASH              &kp DELETE
                                                &lt 3 LEFT_GUI    &lt 2 SPACE         &lt 5 TAB    &lt 3 ENTER  &lt 2 BACKSPACE
            >;
        };

        Numbers {
            label = "Numbers";
            bindings = <
&kp GRAVE  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0  &trans
&trans     &trans           &trans           &trans           &trans           &trans             &kp KP_DOT       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &trans
&trans     &trans           &trans           &trans           &trans           &trans             &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS      &trans
                                             &trans           &trans           &trans             &trans           &trans
            >;
        };

        Symbols {
            label = "Symbols";
            bindings = <
&kp GRAVE  &kp EXCL        &kp AT        &kp HASH  &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS          &kp ASTERISK       &kp LPAR        &kp RPAR          &kp PIPE
&kp TILDE  &kp UNDERSCORE  &kp KP_MINUS  &kp PLUS  &kp KP_EQUAL  &trans       &trans     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp DOUBLE_QUOTES
&trans     &trans          &trans        &trans    &trans        &trans       &trans     &trans            &trans             &kp LESS_THAN   &kp GREATER_THAN  &trans
                                         &trans    &trans        &trans       &trans     &trans
            >;
        };

        FkeysMedia {
            label = "FkeysMedia";
            bindings = <
&kp F1                &kp F2          &kp F3            &kp F4      &kp F5      &kp F6               &kp F7  &kp F8  &kp F9  &kp F10  &kp F11               &kp F12
&kp C_BRIGHTNESS_INC  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp K_MUTE  &kp C_NEXT  &kp C_VOLUME_UP      &trans  &trans  &trans  &trans   &trans                &trans
&kp C_BRIGHTNESS_DEC  &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_STOP  &kp K_NEXT  &kp C_VOLUME_DOWN    &trans  &trans  &trans  &trans   &kp C_MEDIA_COMPUTER  &kp K_CALCULATOR
                                                        &trans      &trans      &trans               &trans  &trans
            >;
        };

        Navigation {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans            &trans          &trans          &trans        &trans           &trans      &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_UP      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp INSERT  &trans
&tog 5  &trans  &msc SCRL_LEFT  &mmv MOVE_DOWN  &msc SCRL_RIGHT  &msc SCRL_DOWN    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp DELETE  &trans
                                &mkp MB1        &mkp MB3         &mkp MB2          &trans          &trans
            >;
        };

        Bluetooth {
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_NXT    &bt BT_CLR      &none  &none  &none  &none  &none
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &bt BT_PRV    &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&none          &none          &none          &none          &none          &none         &none           &none  &none  &none  &none  &none
                                             &none          &none          &none         &none           &none
            >;
        };

        Settings {
            bindings = <
&none  &to 1  &to 0  &none  &none  &none    &none  &none       &none        &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &sys_reset  &bootloader  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none       &none        &none  &none  &none
                     &none  &none  &none    &none  &none
            >;
        };

        SWAP {
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none  &none  &mo 6  &mo 7  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none
            >;
        };
    };
};
